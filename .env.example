# ================================================================
# Archivo de ejemplo para variables de entorno del asistente
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# ================================================================

# === LLM ===
# Clave de API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre del modelo a usar (gpt-4o-mini es el más económico)
MODEL_NAME=gpt-4o-mini

# Pon "true" para usar Ollama en lugar de OpenAI (modelo local, gratuito)
USE_OLLAMA=false

# === Base de datos ===
# Cadena de conexión SQLAlchemy — descomenta y edita la que corresponda:

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://usuario:contraseña@localhost:5432/nombre_bd

# MySQL / MariaDB
# DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/nombre_bd

# SQLite (archivo local, no requiere servidor)
# DATABASE_URL=sqlite:///./mi_base.db

# SQL Server (requiere ODBC Driver instalado)
# DATABASE_URL=mssql+pyodbc://usuario:contraseña@servidor/nombre_bd?driver=ODBC+Driver+17+for+SQL+Server

# === PDFs ===
# Carpeta donde se encuentran los archivos PDF a indexar
PDF_FOLDER=./docs
